# Explicit BNB Smart Chain Mainnet profile
AURIX_NETWORK_PROFILE=MAINNET
BSC_MAINNET_RPC_URL=
BSC_MAINNET_CHAIN_ID=56

# Fixed production token. Do not substitute IRB or another address.
AURX_TOKEN_ADDRESS=0x24ECb00840081D56116fC6D076988411a5595fd0

# There is no Mainnet AurixRewardClaim deployment yet.
MAINNET_REWARD_CONTRACT_ADDRESS=

# Every address below requires explicit owner approval.
MAINNET_DEPLOYER_ADDRESS=
MAINNET_DEFAULT_ADMIN_ADDRESS=
MAINNET_APPROVER_MANAGER_ADDRESS=
MAINNET_APPROVER_ADDRESS=
MAINNET_CAMPAIGN_MANAGER_ADDRESS=
MAINNET_PAUSER_ADDRESS=
MAINNET_TREASURY_RECOVERY_ADDRESS=

# Never persist true. Set it only on the authorized deployment invocation.
MAINNET_DEPLOYMENT_ENABLED=false
MAINNET_TESTNET_ADDRESS_REUSE_APPROVED=false

# Deployment-only secret; leave empty for read-only readiness.
MAINNET_DEPLOYER_PRIVATE_KEY=
DEPLOY_CONFIRMATIONS=5
ETHERSCAN_API_KEY=
