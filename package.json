{
  "name": "@aurixnetwork/aurix-reward-contract",
  "version": "1.0.0",
  "private": true,
  "description": "Aurix Network EIP-712 reward authorization and self-claim contract",
  "license": "MIT",
  "scripts": {
    "clean": "hardhat clean && rimraf coverage coverage.json dist",
    "compile": "hardhat compile",
    "lint": "solhint 'contracts/**/*.sol' && tsc --noEmit",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "preflight:irb": "hardhat run scripts/preflight-irb-testnet.ts --network bscTestnet",
    "deploy:testnet:check": "hardhat run scripts/check-testnet-deployment.ts --network bscTestnet",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.ts --network bscTestnet",
    "validate:testnet:deployment": "hardhat run scripts/validate-testnet-deployment.ts --network bscTestnet",
    "verify:testnet": "hardhat run scripts/verify-testnet.ts --network bscTestnet",
    "export:abi": "hardhat run scripts/export-abi.ts"
  },
  "engines": {
    "node": "22.23.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "6.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.0",
    "rimraf": "6.1.3",
    "solhint": "6.2.3",
    "solidity-coverage": "0.8.17",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
